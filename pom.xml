<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.iter.codac.units</groupId>
    <artifactId>nds3-core</artifactId>
    <packaging>codac</packaging>
    <version>3.1.0.0</version>
    <name>CODAC Core System NDS-Core (v3) module</name>
    <description>NDS (Nominal Device Support) is a library that allows to write
    device support, hiding control system details and focusing on device functionalities.</description>
    <url>https://github.com/Cosylab/nds3</url>
 
    <!-- project properties -->
    <properties>
        <unit.type>module</unit.type>
    </properties>

    <!-- parent pom.xml -->
    <parent>
        <groupId>org.iter.codac.units</groupId>
        <artifactId>maven-iter-settings</artifactId>
        <version>5.4.0</version>
    </parent>

    <!-- unit owner and developers -->
    <developers>
        <developer>
            <id>langer</id>
            <roles>
                <role>unit owner</role>
            </roles>
        </developer>
	<developer>
            <id>ruizm</id>
            <roles>
                <role>developer</role>
            </roles>
        </developer>
	<developer>
            <id>morenoj1</id>
            <roles>
                <role>developer</role>
            </roles>
        </developer>
    </developers>

    <!-- configuration of how the project is built -->
    <build>
        <!-- default phase is compile -->
        <defaultGoal>compile</defaultGoal>
        <!-- this command is executed if you just write 'mvn' -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-iter-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <packaging>

                        <package>
                            <include type="library" name="nds3" />
                        </package>
						<package develof="">
                            <include type="file" source="main/c++/include/nds3" target="include/">
                                <include>*.h</include>
                            </include>
                        </package>

                        <package name="impl-devel">
                            <include type="file" source="main/c++/include/nds3/impl" target="include/nds3/" />
                            <requires codac="true">nds3-core-devel</requires>
                        </package>
						<package name ="testdevices-nds-epics">
							<include type="library" name="nds3-DeviceDBL" />
							<include type="library" name="nds3-DeviceDigitalIO" />
							<include type="library" name="nds3-DeviceFirmware" />
							<include type="library" name="nds3-DeviceFTE" />
							<include type="library" name="nds3-DeviceHQMonitor" />
							<include type="library" name="nds3-DeviceI32" />
							<include type="library" name="nds3-DeviceRouting" />
							<include type="library" name="nds3-DeviceStateMachine" />
							<include type="library" name="nds3-DeviceTiming" />
							<include type="library" name="nds3-DeviceTimestamping" />
			   				<include type="library" name="nds3-DevicePVs" />
							<include type="library" name="nds3-DeviceVectorI32" />
							<include type="library" name="nds3-DeviceVectorI8" />
							<include type="library" name="nds3-DeviceVectorUI8" />
							<include type="library" name="nds3-DeviceVectorDBL" />
							
			   				<requires codac="true">nds3-core-devel</requires>
						</package>

			<package name="doc">
                            <include type="doxygen" name="NDS3" project="${project.name}" version="${project.version}" optimize="c">
				<filepattern>*.dox</filepattern>
                                <filepattern>*.h</filepattern>
                                <filepattern>*.cpp</filepattern>
				<outputformat>html</outputformat>
                                <outputformat>pdf</outputformat>
                                <input>main/c++/doc</input>
                                <input>main/c++/include</input>
				<input>main/c++/nds</input>
                                <input>test/c++/nds</input>
                                <input>test/c++/include</input>
				<examplepath>main/c++/examples</examplepath>
                                <properties>
                                	<SORT_MEMBER_DOCS>NO</SORT_MEMBER_DOCS>
                                	<HIDE_UNDOC_CLASSES>YES</HIDE_UNDOC_CLASSES>
					<RECURSIVE>YES</RECURSIVE>
                                	<EXTRACT_ALL>YES</EXTRACT_ALL>
                                	<HIDE_UNDOC_MEMBERS>NO</HIDE_UNDOC_MEMBERS>
                                	<EXTRACT_PRIVATE>YES</EXTRACT_PRIVATE>
                                	<SOURCE_BROWSER>YES</SOURCE_BROWSER>
                                	<SHOW_FILE>YES</SHOW_FILE>
                                	<HAVE_DOT>YES</HAVE_DOT>
                                	<DOT_FONTNAME>FreeSans</DOT_FONTNAME>
                                	<DOT_FONTSIZE>10</DOT_FONTSIZE>
                                	<CLASS_GRAPH>YES</CLASS_GRAPH>
                                	<COLLABORATION_GRAPH>YES</COLLABORATION_GRAPH>
                                	<GROUP_GRAPHS>YES</GROUP_GRAPHS>
                                	<INCLUDE_GRAPH>YES</INCLUDE_GRAPH>
                                	<INCLUDED_BY_GRAPH>YES</INCLUDED_BY_GRAPH>
                                	<CALL_GRAPH>YES</CALL_GRAPH>
                                	<CALLER_GRAPH>YES</CALLER_GRAPH>
                                	<GRAPHICAL_HIERARCHY>YES</GRAPHICAL_HIERARCHY>
                                	<DIRECTORY_GRAPH>YES</DIRECTORY_GRAPH>
                                	<DOT_IMAGE_FORMAT>png</DOT_IMAGE_FORMAT>
                                	<EXTRACT_STATIC>YES</EXTRACT_STATIC>
                                </properties>
                            </include>
                        </package>
			<package unitPrefix="false" name="nds3-core-examples">

                            <include type="source" source="src/main/c++/examples" target="examples/nds3/src/main/c++/devices" />
                            <include type="source" source="example-Makefile" target="examples/nds3/src/main/c++/Makefile" />
			    <include type="source" source="example-pom.xml" target="examples/nds3/pom.xml" />
		            <include type="source" source="src/test/c++/include" target="examples/nds3/src/test/c++/include"/>
			    <include type="source" source="src/test/c++/ndsex1" target="examples/nds3/src/test/c++/ndsex1"/>
			    <include type="source" source="src/test/c++/Makefile" target="examples/nds3/src/test/c++/Makefile"/>
                            <requires codac="true">nds3-core-devel</requires>
                        </package>

                    </packaging>
                </configuration>
             </plugin>
        </plugins>
    </build>
</project>

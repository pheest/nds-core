<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.iter.codac.units</groupId>
    <artifactId>nds3-core</artifactId>
    <packaging>codac</packaging>
    <version>3.0.2.0</version>
    <name>CODAC Core System nds-core (v3) module</name>
    <description>CODAC Core System nds-core (v3) module</description>
    <url>http://www.iter.org/</url>
 
    <!-- project properties -->
    <properties>
        <unit.type>module</unit.type>
    </properties>

    <!-- parent pom.xml -->
    <parent>
        <groupId>org.iter.codac.units</groupId>
        <artifactId>maven-iter-settings</artifactId>
        <version>5.4.0</version>
    </parent>

    <!-- unit owner and developers -->
    <developers>
        <developer>
            <id>langer</id>
            <roles>
                <role>unit owner</role>
            </roles>
        </developer>
        <developer>
            <id>ebernal</id>
            <roles>
                <role>developer</role>
            </roles>
        </developer>
    </developers>

    <!-- configuration of how the project is built -->
    <build>
        <!-- default phase is compile -->
        <defaultGoal>compile</defaultGoal>
        <!-- this command is executed if you just write 'mvn' -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-iter-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <packaging>
                        <package>
                            <include type="library" name="nds3" />
                        </package>
                        <package develof="nds3-core">
                            <include type="file" source="main/c++/include/nds3" target="include/" />
                        </package>
                        <package unitPrefix="false" name="nds3-examples">
                            <include type="library" name="nds3-dev-oscilloscope" />
                            <include type="library" name="nds3-dev-oscilloscopemultichannel" />
                            <include type="library" name="nds3-dev-thermometer" />
                            <include type="library" name="nds3-dev-devicesimulator" />
                            <requires codac="true">nds3-core</requires>
                        </package>
                    </packaging>
                </configuration>
             </plugin>
        </plugins>
    </build>
</project>

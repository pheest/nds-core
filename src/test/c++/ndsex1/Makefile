NDSLIBDIR:= $(realpath ../../../../target/lib)


ENV_CXXFLAGS := -I../../../../target/main/c++/include/ -I../../../../target/main/c++/examples/ -I../../../../target/main/c++/devices -I/opt/codac/include --coverage
                 
ENV_LDFLAGS :=  -L../../../../target/lib -L/opt/codac/lib --coverage  -Wl,-rpath=../../../../target/lib



TESTS = nds3core-unit-ndsex1

all : $(TESTS)

CXXFLAGS += $(ENV_CXXFLAGS) -MMD -MP -g -Wall -std=c++11
LDFLAGS += $(ENV_LDFLAGS) 
LDFLAGS += -lpthread -lnds3 -ldl -lrt -lgtest -lnds3-dev-ndsex1 

TESTS_OBJS = $(patsubst %.cpp,%.o,$(wildcard *.cpp))

$(TESTS): $(TESTS_OBJS) 
	$(CXX) -o $@ $^ $(LDFLAGS)

clean :
	@$(RM) $(TESTS)  *.o *.d

# include header dependency files generated by -MMD
-include $(wildcard *.d)


NDSLIBDIR:= $(realpath ../../../../target/lib)


ENV_CXXFLAGS := -I../../../../target/main/c++/include/ -I../../../../target/main/c++/examples/ndsex1 -I../../../../target/main/c++/devices -I/opt/codac/include --coverage
                 
ENV_LDFLAGS :=  -L../../../../target/lib -L/opt/codac/lib --coverage  -Wl,-rpath=../../../../target/lib



TESTS = nds3core-unit-ndsex1

all : $(TESTS)

CXXFLAGS += $(ENV_CXXFLAGS) -MMD -MP -g -Wall -std=c++0x
LDFLAGS += $(ENV_LDFLAGS) 

TESTS_OBJS = $(patsubst %.cpp,%.o,$(wildcard *.cpp))

$(TESTS): $(TESTS_OBJS) gtest_main.a
	$(CXX) -o $@ $^ $(LDFLAGS)

clean :
	@$(RM) $(TESTS) gtest.a gtest_main.a *.o *.d

# include header dependency files generated by -MMD
-include $(wildcard *.d)

# Much of this code is copied from gtest/make/Makefile; it probably doesn't
# need to be modified

# If ITER CCS
ifneq ($(CODAC_ROOT),)
GTEST_DIR := $(CODAC_ROOT)/common/gtest
else # NI
GTEST_DIR := /usr/local/bin/gtest-1.6.0
endif

CXXFLAGS += -I$(GTEST_DIR) -I$(GTEST_DIR)/include

LDFLAGS += -lpthread -lnds3 -ldl -lrt -lndsex1 

GTEST_HEADERS_ := $(GTEST_DIR)/include/gtest/*.h \
                  $(GTEST_DIR)/include/gtest/internal/*.h

GTEST_SRCS_ := $(GTEST_DIR)/src/*.cc $(GTEST_DIR)/src/*.h $(GTEST_HEADERS_)

# For simplicity and to avoid depending on Google Test's
# implementation details, the dependencies specified below are
# conservative and not optimized.  This is fine as Google Test
# compiles fast and for ordinary users its source rarely changes.
gtest-all.o : $(GTEST_SRCS_)
	$(CXX) $(CPPFLAGS) -I$(GTEST_DIR) $(CXXFLAGS) -c \
            $(GTEST_DIR)/src/gtest-all.cc

gtest_main.o : $(GTEST_SRCS_)
	$(CXX) $(CPPFLAGS) $(LDFLAGS) -I$(GTEST_DIR) $(CXXFLAGS) -c \
            $(GTEST_DIR)/src/gtest_main.cc

gtest.a : gtest-all.o
	$(AR) $(ARFLAGS) $@ $^

gtest_main.a : gtest-all.o gtest_main.o
	$(AR) $(ARFLAGS) $@ $^


